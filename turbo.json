{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalDependencies": [".nvmrc"],
  "futureFlags": { "strictTaskEntrypointSelection": true },
  "tasks": {
    "topo": { "dependsOn": ["^topo"] },
    "build": { "outputs": ["dist/**"] },
    "typecheck": { "dependsOn": ["topo"] },
    "lint": { "dependsOn": ["topo"] },
    "test": { "outputs": [] },
    "dev": { "cache": false, "persistent": true },
    "//#lint:root": {},
    "//#typecheck:root": {}
  }
}
