{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalDependencies": [".nvmrc"],
  "futureFlags": { "strictTaskEntrypointSelection": true },
  "tasks": {
    "topo": { "dependsOn": ["^topo"] },
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "typecheck": { "dependsOn": ["topo"] },
    "lint": { "dependsOn": ["topo"] },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "env": ["LOG_LEVEL", "TEST_DATABASE_URL"]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "env": ["LOG_LEVEL", "TEST_DATABASE_URL"]
    },
    "dev": { "dependsOn": ["^build"], "cache": false, "persistent": true },
    "e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["CI", "E2E_BASE_URL", "PLAYWRIGHT_*"]
    },
    "//#lint:root": {},
    "//#typecheck:root": {}
  }
}
