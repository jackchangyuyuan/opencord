# Development defaults. The production host keeps its own .env beside
# compose.prod.yaml: same names, real values, and the handful below that only
# production reads.
#
#   DOMAIN=opencord.example.com        the certificate's name
#   ACME_EMAIL=you@example.com         where Let's Encrypt sends expiry notices
#   GIT_SHA=<commit sha>               the image tag a deploy names, and the one
#                                      it rolls back to
#   IMAGE_NAMESPACE=<github owner>     lowercase; the GHCR namespace CI publishes
#                                      opencord-api and opencord-web into
#   IMAGE_REGISTRY=ghcr.io             only set to override the default
#   PUBLIC_ORIGIN=https://opencord.example.com
#   STORAGE_PUBLIC_ORIGIN=https://<bucket>.s3.<region>.amazonaws.com
#
# S3_ENDPOINT and S3_PUBLIC_ENDPOINT are left unset in production, which is what
# points the SDK at the real AWS endpoint for the region rather than at a
# development substitute.


NODE_ENV=development
LOG_LEVEL=info
INSTANCE_ID=api-dev
PUBLIC_ORIGIN=http://localhost:5173
PORT=3000
TRUST_PROXY_HOPS=0

POSTGRES_USER=opencord
POSTGRES_PASSWORD=change-me
POSTGRES_DB=opencord

DATABASE_URL=postgres://opencord:change-me@localhost:5432/opencord
REDIS_URL=redis://localhost:6379

BETTER_AUTH_SECRET=change-me-development-secret-only

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

RATE_LIMIT_NAMESPACE=rl
JOB_LOCK_NAMESPACE=jobs
PRESENCE_NAMESPACE=presence
SOCKET_ADAPTER_KEY=socket.io
RATE_LIMIT_AUTH_POINTS=20
RATE_LIMIT_CREATE_POINTS=10
RATE_LIMIT_INVITE_POINTS=10
RATE_LIMIT_MESSAGE_POINTS=5
RATE_LIMIT_SEARCH_POINTS=10
RATE_LIMIT_TYPING_POINTS=1
RATE_LIMIT_HEARTBEAT_POINTS=1
RATE_LIMIT_UPLOAD_POINTS=20
RATE_LIMIT_DEMO_POINTS=5
RATE_LIMIT_DEMO_DAILY_POINTS=500
RATE_LIMIT_CLAIM_POINTS=5

MEDIA_URL_TTL_PRIVATE=900
MEDIA_URL_TTL_PUBLIC=86400
MEDIA_URL_SIGNING_BUCKET=3600

GUEST_TTL_MS=2700000
GUEST_MESSAGE_CEILING=200
GUEST_UPLOAD_GRANT_CEILING=10
GUEST_UPLOAD_BYTES_CEILING=26214400
GUEST_SERVER_CEILING=5
GUEST_INVITE_CEILING=20

AMBIENT_ACTIVITY_INTERVAL_MS=40000
AMBIENT_ACTIVITY_RETENTION_MS=21600000

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=opencord-dev
AWS_SECRET_ACCESS_KEY=opencord-dev-secret
S3_BUCKET=opencord-dev-uploads
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
STORAGE_PUBLIC_ORIGIN=http://localhost:9000
