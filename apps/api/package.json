{
  "name": "@opencord/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-migrations.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:drop": "drizzle-kit drop",
    "db:bootstrap": "tsx --env-file=../../.env src/db/bootstrap.ts",
    "db:migrate": "tsx --env-file=../../.env src/db/migrate.ts",
    "db:seed": "tsx --env-file=../../.env src/db/seed/index.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-presigned-post": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@better-auth/drizzle-adapter": "^1.7.2",
    "@faker-js/faker": "^10.6.0",
    "@opencord/shared": "workspace:*",
    "@socket.io/redis-adapter": "^8.3.0",
    "better-auth": "^1.7.2",
    "drizzle-orm": "1.0.0-rc.4",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "nanoid": "^6.0.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "postgres": "^3.4.9",
    "rate-limiter-flexible": "^11.2.0",
    "socket.io": "^4.8.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@opencord/eslint-config": "workspace:*",
    "@opencord/typescript-config": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "catalog:",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "catalog:",
    "pino-pretty": "^13.1.3",
    "socket.io-client": "catalog:",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
